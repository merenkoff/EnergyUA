generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Дерево категорій (як «Тепла підлога → Нагрівальні мати»).
model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  nameUk      String     @map("name_uk")
  nameRu      String?    @map("name_ru")
  description String?    @db.Text
  parentId    String?    @map("parent_id")
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  sortOrder   Int        @default(0) @map("sort_order")
  products    Product[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  logoUrl   String?   @map("logo_url")
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("brands")
}

/// Товарна позиція каталогу (без кошика поки що — лише відображення).
model Product {
  id               String         @id @default(cuid())
  slug             String         @unique
  /// Внутрішній або зовнішній артикул (на кшталт «Код: 132814» на ЕТ-маркет).
  sku              String?        @unique
  nameUk           String         @map("name_uk")
  nameRu           String?        @map("name_ru")
  shortDescription String?        @map("short_description") @db.Text
  description      String?        @db.Text
  priceUah         Decimal?       @map("price_uah") @db.Decimal(12, 2)
  /// Показувати ціну в каталозі чи лише «за запитом».
  priceVisible     Boolean        @default(false) @map("price_visible")
  /// Ціна комплекту з прайсу (секція + гофра + коробка / термостат), грн.
  priceKitUah      Decimal?       @map("price_kit_uah") @db.Decimal(12, 2)
  /// Одиниця ціни: шт (за замовчуванням), м (погонний), м² (плівка).
  priceUnit        String?        @map("price_unit")
  /// Примітка до ціни: «під замовлення», «акційна ціна», курс валюти тощо.
  priceNote        String?        @map("price_note")
  categoryId       String         @map("category_id")
  category         Category       @relation(fields: [categoryId], references: [id])
  brandId          String?        @map("brand_id")
  brand            Brand?         @relation(fields: [brandId], references: [id])
  published        Boolean        @default(false)
  sortOrder        Int            @default(0) @map("sort_order")
  seoTitle         String?        @map("seo_title")
  seoDescription   String?        @map("seo_description") @db.Text
  /// Ідемпотентний імпорт (et_market, in_heat, …).
  externalSource   String?        @map("external_source")
  /// Зовнішній id картки на донорі — головний ключ разом із externalSource для upsert.
  externalId       String?        @map("external_id")
  /// Канонічний URL товару на донорі (оновлюється кожним імпортом).
  externalUrl      String?        @map("external_url") @db.Text
  /// URL розділу донора (для плоского мапінгу категорій при повторних імпортах).
  sourceCategoryUrl String?       @map("source_category_url") @db.Text
  /// Нормалізована назва для евристик дублікатів між джерелами (імпорт).
  nameNormKey          String?  @map("name_norm_key")
  /// Якщо задано — цей рядок прихований з каталогу; канонічна картка `mergedInto`.
  mergedIntoProductId  String?   @map("merged_into_product_id")
  mergedInto           Product?  @relation("ProductDuplicateMerge", fields: [mergedIntoProductId], references: [id], onDelete: SetNull)
  mergedDuplicates     Product[] @relation("ProductDuplicateMerge")
  /// Архівна картка (старий каталог з донорів et_market / in_heat / vsesezon).
  /// Не показується в публічному каталозі, поки прапорець не знято в адмінці.
  archived             Boolean   @default(false)
  images               ProductImage[]
  specs                ProductSpec[]
  tags                 ProductTag[]
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@unique([externalSource, externalId])
  @@index([categoryId])
  @@index([brandId])
  @@index([published, sortOrder])
  @@index([archived, published])
  @@index([nameNormKey])
  @@index([mergedIntoProductId])
  @@map("products")
}

/// Мітка (label): один товар може мати багато міток — застосування, конструкція, країна, потужність.
/// На відміну від категорії, мітки не утворюють дерево і не є «папкою» товару.
model Tag {
  id          String       @id @default(cuid())
  slug        String       @unique
  nameUk      String       @map("name_uk")
  /// Група міток (zastosuvannia, konstruktsiia, funktsii, kraina, potuzhnist, …) — для згрупованого виводу.
  groupSlug   String?      @map("group_slug")
  description String?      @db.Text
  sortOrder   Int          @default(0) @map("sort_order")
  products    ProductTag[]
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([groupSlug, sortOrder])
  @@map("tags")
}

model ProductTag {
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tagId     String  @map("tag_id")
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
  @@map("product_tags")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  /// Після mirror — зовнішній URL, з якого зроблено файл (для repair, якщо volume порожній).
  sourceUrl String? @map("source_url") @db.Text
  altUk     String? @map("alt_uk")
  sortOrder Int     @default(0) @map("sort_order")

  @@index([productId])
  @@map("product_images")
}

/// Визначення характеристики (площа, Вт/м², напруга) — під фільтри та картку товару.
model SpecDefinition {
  id         String        @id @default(cuid())
  slug       String        @unique
  labelUk    String        @map("label_uk")
  labelRu    String?       @map("label_ru")
  unit       String?
  groupSlug  String?       @map("group_slug")
  filterable Boolean       @default(false)
  sortOrder  Int           @default(0) @map("sort_order")
  values     ProductSpec[]

  @@map("spec_definitions")
}

model ProductSpec {
  id           String         @id @default(cuid())
  productId    String         @map("product_id")
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  definitionId String         @map("definition_id")
  definition   SpecDefinition @relation(fields: [definitionId], references: [id])
  valueText    String?        @map("value_text")
  valueNumber  Decimal?       @map("value_number") @db.Decimal(18, 6)

  @@unique([productId, definitionId])
  @@index([definitionId, valueNumber])
  @@map("product_specs")
}
